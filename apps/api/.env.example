# apps/api 환경 변수 예시. 실제 값은 .env 에 (커밋 금지)
PORT=8080
# 쉼표로 구분. 배포 후 Firebase Hosting 주소 추가
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 운영에서는 Secret Manager에서 주입. 개발 중 비우면 켤 때마다 임의 키 생성
JWT_SECRET=
SESSION_MINUTES=30
MAX_IMAGE_BYTES=2097152
# fake: Gemini 없이 항상 첫 화면이라고 답함(연습용) / gemini: 실제 식별
IDENTIFIER=fake
GOOGLE_CLOUD_PROJECT=axial-sunup-488315-k1
GOOGLE_CLOUD_LOCATION=global
MODEL_FLASH=gemini-3.8-flash
IDENTIFY_CONFIDENCE_MIN=0.7
IDENTIFY_PER_MINUTE=30
IDENTIFY_TOTAL_CAP=2000
EMERGENCY_STOP=false
