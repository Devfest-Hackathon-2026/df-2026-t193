{
  "name": "tonari-navi",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tonari/web",
    "build": "npm run build -w @tonari/web",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @tonari/web",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p apps/web --noEmit && tsc -p apps/api --noEmit",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx}\" \"apps/web/e2e/*.{ts,tsx}\" \"packages/shared/src/*.ts\" \"apps/api/src/*.ts\"",
    "voice:generate": "vite-node apps/web/scripts/generate-voice.ts --",
    "fixtures:kiosk": "vite-node apps/web/scripts/make-kiosk-fixtures.ts --",
    "api:check": "vite-node apps/web/scripts/check-api.ts --",
    "dev:api": "npm run dev -w @tonari/api"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
